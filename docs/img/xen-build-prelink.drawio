<mxfile host="app.diagrams.net" version="24.7.5">
  <diagram name="prelink.o and xen-syms" id="prelink-xen-syms">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Xen build: prelink.o vs xen-syms / xen (.cmd file coverage)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="30" as="geometry" />
        </mxCell>

        <!-- built_in.o group -->
        <mxCell id="builtins" value="common/built_in.o&#10;drivers/built_in.o&#10;lib/built_in.o&#10;xsm/built_in.o&#10;arch/x86/built_in.o" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- lib.a group -->
        <mxCell id="libs" value="arch/x86/lib/lib.a&#10;arch/x86/lib/cpu-policy/lib.a&#10;lib/lib.a&#10;(--start-group..--end-group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ld -r command label -->
        <mxCell id="ldcmd" value="ld -melf_x86_64 -r -o prelink.o ..." style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="150" width="230" height="40" as="geometry" />
        </mxCell>

        <!-- prelink.o -->
        <mxCell id="prelink" value="prelink.o" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="150" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="prelinkNote" value=".prelink.o.cmd EXISTS&#10;(cmd_prelink.o := ld -r ...)&#10;&#10;=&gt; PoC/KernelSbom root artifact&#10;(parseable by standard ld parser)" style="text;html=1;fontSize=11;align=left;fontColor=#2d7600;" vertex="1" parent="1">
          <mxGeometry x="540" y="240" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- arrow builtins/libs -> prelink -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="builtins" target="prelink">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="libs" target="prelink">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- xen.lds -->
        <mxCell id="xenlds" value="xen.lds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="xenlds" target="prelink">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- multi-pass recipe box -->
        <mxCell id="recipe" value="arch/x86/Makefile: $(TARGET)-syms recipe&#10;(2-pass symbol table generation, single Make rule)&#10;&#10;1) ld -T xen.lds prelink.o ... -o .xen-syms.0&#10;2) nm .xen-syms.0 | tools/symbols &gt; .xen-syms.1.S ; ld -> .xen-syms.1&#10;3) nm .xen-syms.1 | tools/symbols &gt; .xen-syms.2.S ; compare-symbol-tables&#10;4) ld ... .xen-syms.2.o -o xen-syms&#10;5) rm -f .xen-syms.[0-9]*  (intermediates deleted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="90" width="340" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="prelink" target="recipe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- xen-syms -->
        <mxCell id="xensyms" value="xen-syms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="recipe" target="xensyms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="xensymsNote" value="NO .xen-syms.cmd / .xen.cmd file&#10;(built entirely inside one Make&#10;recipe, not via if_changed/cmd_file)&#10;&#10;=&gt; NOT usable as KernelSbom root" style="text;html=1;fontSize=11;align=left;fontColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="880" y="350" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- xen final -->
        <mxCell id="xenfinal" value="xen (final image)&#10;objcopy + gzip -&gt; xen.gz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="xensyms" target="xenfinal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- footer summary -->
        <mxCell id="summary" value="Summary: prelink.o is an intermediate artifact aggregating all built_in.o/lib.a, distinct from the final xen binary.&#10;It is chosen as the SBOM root because it is the last point in the build with a Kbuild .cmd file;&#10;the subsequent xen-syms / xen steps run inside a single Makefile recipe and leave no .cmd trace for KernelSbom to follow." style="text;html=1;fontSize=12;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1080" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
